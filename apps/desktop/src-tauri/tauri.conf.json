{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Seijaku",
	"version": "0.1.0",
	"identifier": "app.seijaku.desktop",
	"build": {
		"beforeDevCommand": "bun run --cwd ../web dev",
		"devUrl": "http://localhost:5173",
		"beforeBuildCommand": "bun run --cwd ../web build",
		"frontendDist": "../../web/dist"
	},
	"app": {
		"macOSPrivateApi": true,
		"windows": [
			{
				"label": "main",
				"title": "Seijaku",
				"width": 1180,
				"height": 780,
				"minWidth": 480,
				"minHeight": 480
			}
		],
		"security": { "csp": null }
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"createUpdaterArtifacts": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"deep-link": { "desktop": { "schemes": ["seijaku"] } },
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5MTE4OUVGNEQ5NjI0MjcKUldRbkpKWk43NGtSZWJWd1F6bG94bUhHYk9hNThQVEZtWFBuTXRQa3UwR2RwUitOd1BtUUx4OXAK",
			"endpoints": [
				"https://github.com/dedyrahmat/seijaku/releases/latest/download/latest.json"
			]
		}
	}
}
