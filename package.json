{
	"name": "seijaku",
	"private": true,
	"version": "0.0.0",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"typecheck": "bun run --filter '*' typecheck",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "bun test",
		"test:e2e": "bun run --cwd apps/web build && playwright test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.7",
		"@playwright/test": "^1.65.1",
		"@types/bun": "^1.4.4",
		"typescript": "^7.0.2"
	}
}
